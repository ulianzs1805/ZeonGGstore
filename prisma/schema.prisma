generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  avatar String?
  role Role @default(USER)
  createdAt DateTime @default(now())
  balance Int @default(0)
  adminProfile AdminProfile?
  devProfile DevProfile?
  testerProfile TesterProfile?
  auditLogs AuditLog[]
  createdCases Case[]
  forceDropAssignments ForceDropAssignment[] @relation("ForceDropAssigner")
  assignedForceDrops ForceDropAssignment[] @relation("ForceDropTarget")
  inventoryItems InventoryItem[]
  notifications Notification[]
  operations Operation[]
  supportMessages SupportMessage[]
  supportTickets SupportTicket[]
  transactions Transaction[]
  zcoinActions ZCoinOperation[] @relation("ZCoinActor")
  zcoinOperations ZCoinOperation[] @relation("ZCoinTarget")
  createdPromoCodes PromoCode[] @relation("PromoCreator")
  promoActivations PromoActivation[]
  freeCaseGrants FreeCaseGrant[]
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  type PromoType
  zCoinAmount Int?
  caseId String?
  maxActivations Int
  activationCount Int @default(0)
  expiresAt DateTime
  createdById String
  createdAt DateTime @default(now())
  creator User @relation("PromoCreator", fields: [createdById], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  activations PromoActivation[]
  @@index([createdById, createdAt])
  @@index([expiresAt])
}

model PromoActivation {
  id String @id @default(cuid())
  promoId String
  userId String
  activatedAt DateTime @default(now())
  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([promoId, userId])
  @@index([userId, activatedAt])
}

model FreeCaseGrant {
  id String @id @default(cuid())
  userId String
  caseId String
  sourcePromoId String?
  createdAt DateTime @default(now())
  consumedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([userId, caseId, consumedAt])
}

model AdminProfile { id String @id @default(cuid()) userId String @unique adminId String @unique status String @default("ACTIVE") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) }
model DevProfile { id String @id @default(cuid()) userId String @unique devId String @unique status String @default("ACTIVE") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) }
model AuditLog { id String @id @default(cuid()) actorUserId String actorRole Role actorAdminId String? action String targetType String targetId String? metadata String status String createdAt DateTime @default(now()) actor User @relation(fields: [actorUserId], references: [id]) @@index([actorUserId, createdAt]) @@index([action, createdAt]) }
model TesterProfile { id String @id @default(cuid()) userId String @unique testerId String @unique isActive Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) }
model Case { id String @id @default(cuid()) slug String @unique name String @unique description String? image String price Int environment Environment @default(SYSTEM) probabilityMode ProbabilityMode @default(MANUAL) isActive Boolean @default(true) createdById String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt createdBy User @relation(fields: [createdById], references: [id]) drops Drop[] forceDropAssignments ForceDropAssignment[] inventoryItems InventoryItem[] @relation("CaseInventory") promoCodes PromoCode[] freeCaseGrants FreeCaseGrant[] @@index([isActive, createdAt]) }
model Drop { id String @id @default(cuid()) caseId String name String rarity String image String price Int probability Float environment Environment @default(SYSTEM) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt case Case @relation(fields: [caseId], references: [id]) forceDropAssignments ForceDropAssignment[] @@index([caseId]) }
model ForceDropAssignment { id String @id @default(cuid()) targetUserId String caseId String dropId String assignedById String reason String status String @default("PENDING") createdAt DateTime @default(now()) consumedAt DateTime? assignedBy User @relation("ForceDropAssigner", fields: [assignedById], references: [id]) case Case @relation(fields: [caseId], references: [id]) drop Drop @relation(fields: [dropId], references: [id]) targetUser User @relation("ForceDropTarget", fields: [targetUserId], references: [id]) @@index([targetUserId, caseId, status]) }
model Notification { id String @id @default(cuid()) userId String type String title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, readAt, createdAt]) }
model InventoryItem { id String @id @default(cuid()) userId String itemId String name String rarity String image String price Int addedAt DateTime @default(now()) soldAt DateTime? caseId String? case Case? @relation("CaseInventory", fields: [caseId], references: [id]) user User @relation(fields: [userId], references: [id], onDelete: Cascade) operations Operation[] @@index([userId, soldAt]) }
model Operation { id String @id @default(cuid()) userId String type String itemId String? label String? amount Int status String createdAt DateTime @default(now()) idempotencyKey String? @unique item InventoryItem? @relation(fields: [itemId], references: [id]) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, createdAt]) }
model Transaction { id String @id @default(cuid()) userId String type String rubAmount Int? zCoinAmount Int status String paymentId String? createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id], onDelete: Cascade) @@index([userId, createdAt]) }
model ZCoinOperation { id String @id @default(cuid()) idempotencyKey String @unique actorUserId String targetUserId String operation String amount Int oldBalance Int newBalance Int reason String status String denialReason String? createdAt DateTime @default(now()) actor User @relation("ZCoinActor", fields: [actorUserId], references: [id]) target User @relation("ZCoinTarget", fields: [targetUserId], references: [id]) }
model SupportTicket { id String @id @default(cuid()) userId String subject String description String status String @default("OPEN") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt messages SupportMessage[] user User @relation(fields: [userId], references: [id], onDelete: Cascade) }
model SupportMessage { id String @id @default(cuid()) ticketId String authorUserId String body String createdAt DateTime @default(now()) author User @relation(fields: [authorUserId], references: [id]) ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade) }

enum Role { USER TESTER ADMIN DEV NPN1_DEV }
enum Environment { SYSTEM TEST }
enum ProbabilityMode { MANUAL DYNAMIC }
enum PromoType { ZCOIN CASE }
